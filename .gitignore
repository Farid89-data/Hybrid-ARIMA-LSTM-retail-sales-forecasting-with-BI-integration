# Environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Large or regenerable artefacts
outputs/interim/
outputs/models/
*.keras

# Raw data is never committed (Kaggle competition rules); see data/README.md
data/raw/
*.zip

# Local-only material (contains personal details from the proposal)
docbuild/baseline/
docbuild/build/

# Superseded runs kept for the record (large intermediate files only)
outputs/archive/*/interim/

# Runner state: pause flags, RESUME.md, status, done markers (D-028)
outputs/state/

# Power BI files store the Kaggle sales data inside the file; never commit them
*.pbix

# Kaggle-derived data: daily store-level sales and forecasts that carry the actual sales (DATA-1).
# Regenerate: run the pipeline (Resume-Pipeline.bat), then python scripts/export_dashboard.py
dashboard/data/fact_actuals.csv
dashboard/data/fact_forecast.csv
dashboard/Dashboard_screenshots.pdf
outputs/forecasts/
outputs/archive/*/*.csv.gz

# Working files for the assistant: not part of the repository
CLAUDE.md
.claude/
reports/review_queue.md

*.pbix
